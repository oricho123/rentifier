{
	"name": "rentifier-processor",
	"main": "src/index.ts",
	"compatibility_date": "2024-01-01",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"triggers": {
		"crons": ["*/15 5-20 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rentifier",
			"database_id": "554a9f64-3cfb-4e27-b83c-0f92907c8794",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"vars": {
		"AI_GATEWAY_ID": "rentifier-ai-gateway",
		"NEIGHBORHOOD_GEOCODER_BUDGET": "30",
		"NEIGHBORHOOD_GEOCODER_USER_AGENT": "rentifier-processor/1.0 (+https://github.com/oricho123/rentifier)"
	},
	"ai": {
		"binding": "AI"
	}
}
